{
  "name": "airwaylink-banner-studio",
  "version": "0.1.10-A",
  "description": "Airwaylink Banner Studio v0.1.8-A // Virtual Airline Banner Tool",
  "scripts": {
    "start": "vite --port 5173 --strictPort",
    "dev": "npm start",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "set-version": "node scripts/set-version.js",
    "theme:revert": "node -e \"const fs=require('fs'); fs.copyFileSync('src/studio.win11-fluent.css','src/studio.css'); console.log('Reverted to original theme.');\"",
    "theme:airwaylink": "node -e \"const fs=require('fs'); fs.copyFileSync('src/studio.airwaylink.css','src/studio.css'); console.log('Restored Airwaylink theme.');\""
  },
  "keywords": [
    "virtual-airline",
    "banner-generator",
    "airwaylink",
    "aviation"
  ],
  "author": "Airwaylink",
  "license": "MIT",
  "private": true,
  "type": "module",
  "dependencies": {
    "@auth0/auth0-react": "^2.30.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.19",
    "vite": "^7.3.7"
  },
  "allowScripts": {
    "browser-tabs-lock@1.3.0": true,
    "esbuild@0.28.2": true
  }
}
